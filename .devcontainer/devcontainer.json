{
  "name": "Dev Container",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "containerUser": "ubuntu",
  "remoteUser": "ubuntu",
  "updateRemoteUserUID": false,
  "runArgs": [
    "--userns=keep-id:uid=1000,gid=1000",
    "--security-opt=label=disable",
    "--security-opt=no-new-privileges=true"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
		    "twxs.cmake"
      ]
    }
  }
}
